tmp/
temp/
*.tmp
*.temp

# cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# claude plans (local planning artifacts)
.claude/plans/

# Linked worktrees, when a tool puts them inside the repo instead of beside it.
# Tracked rather than left to .git/info/exclude, which is per-clone: without this a
# fresh clone's first lint or check would walk every nested worktree's full source
# tree. Anchored on purpose -- see the worktrees section of AGENTS.md for what an
# unanchored pattern does to a worktree that sits under this path.
.claude/worktrees/

# MCP servers
.mcp/memory.db
.mcp/memory.db-*
.mcp/cache/
.mcp/logs/

# Keep configuration files
!.mcp/servers.json
!.mcp/README.md
!.mcp/servers/*.json

.claude/settings.local.json

# Local map from the consumer labels in
# docs/integrations/consumer-api-dependencies.md to checkout paths on this
# machine. Never commit it: the pad is deliberately label-only because this
# repository is public and those consumers are not. See
# .claude/skills/consumer-dependency-audit/SKILL.md.
.claude/consumer-checkouts.local.json

# A real secure assessment item, imported from the Renaissance bank to prove the
# PIE-881 transform end to end. Never commit it: it carries live item content and
# its correct answer. The demo loads it only when present — see
# apps/section-demos/src/lib/content/demo-sign-language.ts.
apps/section-demos/src/lib/content/pie881-imported-asl-item.json
