{
	"name": "@pie-players/lti-demos",
	"version": "0.1.31",
	"description": "LTI host integration demos for PIE Players",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pie-players/demo-ui": "workspace:*",
		"@pie-players/pie-assessment-player": "workspace:*",
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.4.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	},
	"license": "MIT"
}
