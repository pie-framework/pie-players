{
	"name": "@pie-players/lti-demos",
	"version": "0.1.36",
	"description": "LTI host integration demos for PIE Players",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pie-players/pie-assessment-player": "workspace:*",
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-default-tool-loaders": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.0",
		"vite": "^8.3.2"
	},
	"license": "MIT",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
