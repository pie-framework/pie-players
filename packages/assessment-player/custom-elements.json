					"customElement": true,
					"superclass": {
						"name": "HTMLElement"
					},
					"members": [
						{
							"kind": "field",
							"name": "assessmentId",
							"type": {
								"text": "string"
							},
							"attribute": "assessment-id"
						},
						{
							"kind": "field",
							"name": "attemptId",
							"type": {
								"text": "string"
							},
							"attribute": "attempt-id"
						},
						{
							"kind": "field",
							"name": "assessment",
							"type": {
								"text": "AssessmentDefinition | null"
							}
						},
						{
							"kind": "field",
							"name": "hooks",
							"type": {
								"text": "AssessmentPlayerHooks | null"
							}
						},
						{
							"kind": "field",
							"name": "session",
							"type": {
								"text": "AssessmentSession | null"
							},
							"description": "Before a controller is ready, the assigned session; after, a copy of the controller's."
						},
						{
							"kind": "field",
							"name": "locale",
							"type": {
								"text": "string"
							},
							"attribute": "locale"
