						{
							"kind": "field",
							"name": "coordinator",
							"type": {
								"text": "unknown"
							}
						},
						{
							"kind": "field",
							"name": "showNavigation",
							"type": {
								"text": "boolean | string | null | undefined"
							},
							"attribute": "show-navigation"
						},
