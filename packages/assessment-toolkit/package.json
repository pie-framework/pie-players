{
	"name": "@pie-players/pie-assessment-toolkit",
	"version": "0.3.75",
	"type": "module",
	"description": "PIE assessment toolkit: composable services + reference implementation for assessment players and tool coordination",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/assessment-toolkit"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.js",
	"jsdelivr": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./tools/registration": {
			"types": "./dist/tools/registration.d.ts",
			"import": "./dist/tools/registration.js"
		},
		"./components/item-scope-element": {
			"types": "./dist/components/item-scope-element.d.ts",
			"import": "./dist/components/item-scope-element.js"
		},
		"./components/item-toolbar-element": {
			"types": "./dist/components/item-toolbar-element.d.ts",
			"import": "./dist/components/item-toolbar-element.js"
		},
		"./components/pie-assessment-toolkit-element": {
			"types": "./dist/components/pie-assessment-toolkit-element.d.ts",
			"import": "./dist/components/pie-assessment-toolkit-element.js"
		},
		"./components/section-toolbar-element": {
			"types": "./dist/components/section-toolbar-element.d.ts",
			"import": "./dist/components/section-toolbar-element.js"
		},
		"./services/AccessibilityCatalogResolver": {
			"types": "./dist/services/AccessibilityCatalogResolver.d.ts",
			"import": "./dist/services/AccessibilityCatalogResolver.js"
		},
		"./runtime/engine": {
			"types": "./dist/runtime/engine.d.ts",
			"import": "./dist/runtime/engine.js"
		},
		"./policy/engine": {
			"types": "./dist/policy/engine.d.ts",
			"import": "./dist/policy/engine.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && bun ./scripts/build-ce-components.mjs",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
		"lint": "biome lint .",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@pie-players/pie-calculator": "workspace:*",
		"@pie-players/pie-context": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"@pie-players/pie-tts": "workspace:*",
		"speech-rule-engine": "5.0.0-rc.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^20.14.5",
		"@pie-players/tts-client-server": "workspace:*",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/assessment-toolkit#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": [
		"./dist/components/*.js",
		"./dist/components/chunks/*.js"
	]
}
