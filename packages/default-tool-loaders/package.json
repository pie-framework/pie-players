{
	"name": "@pie-players/pie-default-tool-loaders",
	"version": "0.3.68",
	"type": "module",
	"description": "Composition layer for the packaged PIE assessment tools: registrations, tag map, placement presets, universal supports and lazy module loaders",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/default-tool-loaders"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun run check:composition && tsc -p tsconfig.json",
		"check:composition": "bun test tests/packaged-capability-composition.test.ts",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"test": "bun test"
	},
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"@pie-players/pie-tool-annotation-toolbar": "workspace:*",
		"@pie-players/pie-tool-answer-eliminator": "workspace:*",
		"@pie-players/pie-tool-calculator-desmos": "workspace:*",
		"@pie-players/pie-tool-calculator-cortex": "workspace:*",
		"@pie-players/pie-tool-calculator-geogebra": "workspace:*",
		"@pie-players/pie-tool-calculator-shared": "workspace:*",
		"@pie-players/pie-tool-dictionary": "workspace:*",
		"@pie-players/pie-tool-graph": "workspace:*",
		"@pie-players/pie-tool-line-reader": "workspace:*",
		"@pie-players/pie-tool-periodic-table": "workspace:*",
		"@pie-players/pie-tool-picture-dictionary": "workspace:*",
		"@pie-players/pie-tool-protractor": "workspace:*",
		"@pie-players/pie-tool-ruler": "workspace:*",
		"@pie-players/pie-tool-theme": "workspace:*",
		"@pie-players/pie-tool-tts-inline": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"typescript": "^5.9.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/default-tool-loaders#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": false
}
