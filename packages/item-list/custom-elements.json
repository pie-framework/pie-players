{
	"schemaVersion": "2.1.0",
	"modules": [
		{
			"kind": "javascript-module",
			"path": "dist/pie-item-list.js",
			"declarations": [
				{
					"kind": "class",
					"description": "PIE items as a list of `<pie-item-summary>` rows, for a host with no list chrome of its own. Each row shows the entry's details in a leading column, the host's actions in its top-end corner, the item's summary clipped to a fixed height, with its passage above it, and the host's search matches below it. The row's expand button removes the clip and mounts the item's player.",
					"name": "PieItemList",
					"tagName": "pie-item-list",
					"customElement": true,
					"members": [
						{
							"kind": "field",
							"name": "items",
							"type": {
								"text": "ItemListEntry[]"
							},
							"default": "[]",
							"attribute": "items"
						},
						{
							"kind": "field",
							"name": "env",
							"type": {
								"text": "Env"
							},
							"attribute": "env"
						},
						{
							"kind": "field",
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"attribute": "resolve"
						},
						{
							"kind": "field",
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"attribute": "locale"
						},
						{
							"kind": "field",
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"attribute": "expanded"
						},
						{
							"kind": "field",
							"name": "strategy",
							"type": {
								"text": "PlayerLoadInputs[\"strategy\"]"
							},
							"attribute": "strategy"
						},
						{
							"kind": "field",
							"name": "loaderOptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"attribute": "loaderoptions"
						},
						{
							"kind": "field",
							"name": "details",
							"type": {
								"text": "ItemListExtension"
							},
							"description": "A tag name can be set as an attribute; a function only as a property.",
							"attribute": "details"
						},
						{
							"kind": "field",
							"name": "actions",
							"type": {
								"text": "ItemListExtension"
							},
							"attribute": "actions"
						},
						{
							"kind": "field",
							"name": "highlights",
							"type": {
								"text": "ItemListExtension"
							},
							"attribute": "highlights"
						}
					],
					"attributes": [
						{
							"name": "items",
							"type": {
								"text": "ItemListEntry[]"
							},
							"default": "[]",
							"fieldName": "items"
						},
						{
							"name": "env",
							"type": {
								"text": "Env"
							},
							"fieldName": "env"
						},
						{
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"fieldName": "resolve"
						},
						{
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"fieldName": "locale"
						},
						{
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"fieldName": "expanded"
						},
						{
							"name": "strategy",
							"type": {
								"text": "string"
							},
							"fieldName": "strategy"
						},
						{
							"name": "loaderoptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"fieldName": "loaderOptions"
						},
						{
							"name": "details",
							"type": {
								"text": "string"
							},
							"description": "A tag name can be set as an attribute; a function only as a property.",
							"fieldName": "details"
						},
						{
							"name": "actions",
							"type": {
								"text": "string"
							},
							"fieldName": "actions"
						},
						{
							"name": "highlights",
							"type": {
								"text": "string"
							},
							"fieldName": "highlights"
						}
					],
					"events": [
						{
							"name": "expanded-change",
							"type": {
								"text": "CustomEvent<{ id: string; expanded: boolean }>"
							},
							"description": "A row's expand button was pressed."
						},
						{
							"name": "player-error",
							"type": {
								"text": "CustomEvent<{ id: string; code: string; message: string; recoverable: boolean }>"
							},
							"description": "A row's player failed to load, with the entry `id` added to `<pie-item-summary>`'s detail."
						},
						{
							"name": "load-complete",
							"type": {
								"text": "CustomEvent<{ view: \"summary\" | \"player\" }>"
							},
							"description": "Bubbles unchanged from each row's `<pie-item-summary>`, passage rows included; the entry's `id` is on the closest `[data-item-id]`."
						}
					],
					"x-pie": {
						"shadow": "none",
						"classes": [
							"pie-item-list",
							"pie-item-list__actions",
							"pie-item-list__content",
							"pie-item-list__details",
							"pie-item-list__extension",
							"pie-item-list__highlights",
							"pie-item-list__id",
							"pie-item-list__item",
							"pie-item-list__name",
							"pie-item-list__passage",
							"pie-item-list__row",
							"pie-item-list__toggle",
							"pie-item-list__version",
							"pie-item-list__view",
							"pie-item-list__view--clipped"
						]
					}
				},
				{
					"kind": "class",
					"description": "One PIE item as a list row: its stem, prompts, options and, for instructors, its answers, rendered as sanitized HTML with math as MathML, loading no element code until it expands. A host gives it the item `config`, or a precomputed `summary`, and keeps its own list, card and expand chrome around it. Set `expanded` and the row mounts `<pie-item-player>` for the item once it nears the viewport, keeps the summary showing until the player has loaded, then swaps it in place.",
					"name": "PieItemSummary",
					"tagName": "pie-item-summary",
					"customElement": true,
					"members": [
						{
							"kind": "field",
							"name": "config",
							"type": {
								"text": "ItemConfig"
							},
							"attribute": "config"
						},
						{
							"kind": "field",
							"name": "env",
							"type": {
								"text": "Env"
							},
							"attribute": "env"
						},
						{
							"kind": "field",
							"name": "summary",
							"type": {
								"text": "ItemSummary"
							},
							"attribute": "summary"
						},
						{
							"kind": "field",
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"attribute": "resolve"
						},
						{
							"kind": "field",
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"description": "Interface locale for the row's own labels, as a BCP-47 tag. Unset renders `en-US`.",
							"attribute": "locale"
						},
						{
							"kind": "field",
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"attribute": "expanded"
						},
						{
							"kind": "field",
							"name": "strategy",
							"type": {
								"text": "PlayerLoadInputs[\"strategy\"]"
							},
							"attribute": "strategy"
						},
						{
							"kind": "field",
							"name": "loaderOptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"attribute": "loaderoptions"
						}
					],
					"attributes": [
						{
							"name": "config",
							"type": {
								"text": "ItemConfig"
							},
							"fieldName": "config"
						},
						{
							"name": "env",
							"type": {
								"text": "Env"
							},
							"fieldName": "env"
						},
						{
							"name": "summary",
							"type": {
								"text": "ItemSummary"
							},
							"fieldName": "summary"
						},
						{
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"fieldName": "resolve"
						},
						{
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"description": "Interface locale for the row's own labels, as a BCP-47 tag. Unset renders `en-US`.",
							"fieldName": "locale"
						},
						{
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"fieldName": "expanded"
						},
						{
							"name": "strategy",
							"type": {
								"text": "string"
							},
							"fieldName": "strategy"
						},
						{
							"name": "loaderoptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"fieldName": "loaderOptions"
						}
					],
					"events": [
						{
							"name": "load-complete",
							"type": {
								"text": "CustomEvent<{ view: \"summary\" | \"player\" }>"
							},
							"description": "`summary` once per rendered summary, after math conversion; a new `env` with the same role does not re-render. `player` once the expanded row's player has loaded and replaced the summary."
						},
						{
							"name": "player-error",
							"type": {
								"text": "CustomEvent<{ code: string; message: string; recoverable: boolean }>"
							},
							"description": "The expanded row's player failed to load, re-dispatched with the player's detail, or did not load in time (`recoverable: true`). The summary keeps showing; collapsing and expanding again retries."
						}
					],
					"x-pie": {
						"shadow": "none",
						"classes": [
							"pie-item-summary",
							"pie-item-summary__answer",
							"pie-item-summary__answer-content",
							"pie-item-summary__answer-label",
							"pie-item-summary__badge",
							"pie-item-summary__entry",
							"pie-item-summary__figure",
							"pie-item-summary__group",
							"pie-item-summary__group-label",
							"pie-item-summary__groups",
							"pie-item-summary__label",
							"pie-item-summary__marker",
							"pie-item-summary__media",
							"pie-item-summary__option",
							"pie-item-summary__option--correct",
							"pie-item-summary__option-label",
							"pie-item-summary__options",
							"pie-item-summary__part",
							"pie-item-summary__player",
							"pie-item-summary__player--pending",
							"pie-item-summary__prompt",
							"pie-item-summary__sr-only",
							"pie-item-summary__stem",
							"pie-item-summary__view"
						]
					}
				}
			],
