{
	"schemaVersion": "2.1.0",
	"modules": [
		{
			"kind": "javascript-module",
			"path": "dist/pie-item-list.js",
			"declarations": [
				{
					"kind": "class",
					"description": "One PIE item as a list row: its stem, prompts, options and, for instructors, its answers, rendered as sanitized HTML with math as MathML, loading no element code until it expands. A host gives it the item `config`, or a precomputed `summary`, and keeps its own list, card and expand chrome around it. Set `expanded` and the row mounts `<pie-item-player>` for the item once it nears the viewport, keeps the summary showing until the player has loaded, then swaps it in place.",
					"name": "PieItemSummary",
					"tagName": "pie-item-summary",
					"customElement": true,
					"members": [
						{
							"kind": "field",
							"name": "config",
							"type": {
								"text": "ItemConfig"
							},
							"attribute": "config"
						},
						{
							"kind": "field",
							"name": "env",
							"type": {
								"text": "Env"
							},
							"attribute": "env"
						},
						{
							"kind": "field",
							"name": "summary",
							"type": {
								"text": "ItemSummary"
							},
							"attribute": "summary"
						},
						{
							"kind": "field",
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"attribute": "resolve"
						},
						{
							"kind": "field",
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"description": "Interface locale for the row's own labels, as a BCP-47 tag. Unset renders `en-US`.",
							"attribute": "locale"
						},
						{
							"kind": "field",
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"attribute": "expanded"
						},
						{
							"kind": "field",
							"name": "strategy",
							"type": {
								"text": "PlayerLoadInputs[\"strategy\"]"
							},
							"attribute": "strategy"
						},
						{
							"kind": "field",
							"name": "loaderOptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"attribute": "loaderoptions"
						}
					],
					"attributes": [
						{
							"name": "config",
							"type": {
								"text": "ItemConfig"
							},
							"fieldName": "config"
						},
						{
							"name": "env",
							"type": {
								"text": "Env"
							},
							"fieldName": "env"
						},
						{
							"name": "summary",
							"type": {
								"text": "ItemSummary"
							},
							"fieldName": "summary"
						},
						{
							"name": "resolve",
							"type": {
								"text": "SummaryResolver"
							},
							"fieldName": "resolve"
						},
						{
							"name": "locale",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"description": "Interface locale for the row's own labels, as a BCP-47 tag. Unset renders `en-US`.",
							"fieldName": "locale"
						},
						{
							"name": "expanded",
							"type": {
								"text": "boolean"
							},
							"default": "false",
							"fieldName": "expanded"
						},
						{
							"name": "strategy",
							"type": {
								"text": "string"
							},
							"fieldName": "strategy"
						},
						{
							"name": "loaderoptions",
							"type": {
								"text": "PlayerLoadInputs[\"loaderOptions\"]"
							},
							"fieldName": "loaderOptions"
						}
					],
					"events": [
						{
							"name": "load-complete",
							"type": {
								"text": "CustomEvent<{ view: \"summary\" | \"player\" }>"
							},
							"description": "`summary` once per rendered summary, after math conversion; a new `env` with the same role does not re-render. `player` once the expanded row's player has loaded and replaced the summary."
						},
						{
							"name": "player-error",
							"type": {
								"text": "CustomEvent<{ code: string; message: string; recoverable: boolean }>"
							},
							"description": "The expanded row's player failed to load, re-dispatched with the player's detail, or did not load in time (`recoverable: true`). The summary keeps showing; collapsing and expanding again retries."
						}
					],
					"x-pie": {
						"shadow": "none",
						"classes": [
							"pie-item-summary",
							"pie-item-summary__answer",
							"pie-item-summary__answer-content",
							"pie-item-summary__answer-label",
							"pie-item-summary__badge",
							"pie-item-summary__entry",
							"pie-item-summary__figure",
							"pie-item-summary__group",
							"pie-item-summary__group-label",
							"pie-item-summary__groups",
							"pie-item-summary__label",
							"pie-item-summary__marker",
							"pie-item-summary__media",
							"pie-item-summary__option",
							"pie-item-summary__option--correct",
							"pie-item-summary__option-label",
							"pie-item-summary__options",
							"pie-item-summary__part",
							"pie-item-summary__player",
							"pie-item-summary__player--pending",
							"pie-item-summary__prompt",
							"pie-item-summary__sr-only",
							"pie-item-summary__stem",
							"pie-item-summary__view"
						]
					}
				}
			],
			"exports": [
				{
					"kind": "custom-element-definition",
					"name": "pie-item-summary",
					"declaration": {
						"name": "PieItemSummary"
					}
				}
			]
		},
		{
			"kind": "javascript-module",
			"path": "dist/browser/pie-item-list.js",
			"declarations": [],
			"exports": [
				{
					"kind": "custom-element-definition",
					"name": "pie-item-summary",
					"declaration": {
						"name": "PieItemSummary",
						"module": "dist/pie-item-list.js"
					}
				}
			]
		}
	]
}
