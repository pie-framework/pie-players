						},
						{
							"name": "session-changed",
							"type": {
								"text": "CustomEvent<{ complete: boolean; component: string; elementId?: string; session: { id: string; data: unknown[] } | null; intent?: \"metadata-only\"; sessionCommitReason?: \"teardown\" | \"navigate\" | \"page-hidden\" }>"
