							"name": "bundle-retry-status",
							"type": {
								"text": "CustomEvent<{ state: \"retrying\" | \"completed\" | \"timeout\" | \"cancelled\"; url: string; attempt: number; elapsedMs: number; timeoutMs: number; retryDelayMs?: number; reason?: string }>"
							},
							"description": "Under the `iife` strategy, as a bundle request is retried, completes, times out or is cancelled."
						},
						{
							"name": "session-snapshot-available",
							"type": {
								"text": "CustomEvent<{ key: string; session: unknown; timestamp: number }>"
							},
							"description": "On load, when `session-snapshot` is enabled and device storage holds a snapshot for this sitting; the player never applies it."
						},
						{
							"name": "backend-load-complete",
							"type": {
								"text": "CustomEvent<{ scope: \"delivery\"; operation: \"load\"; metadata: Record<string, unknown>; session: unknown } | { scope: \"authoring\"; operation: \"load\"; contentId?: string; metadata: Record<string, unknown>; config: unknown }>"
