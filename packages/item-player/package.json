{
	"name": "@pie-players/pie-item-player",
	"version": "1.0.0-beta.6",
	"type": "module",
	"description": "Unified custom element for rendering PIE items with iife/esm/preloaded strategies",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/item-player"
	},
	"publishConfig": {
		"access": "public"
	},
	"unpkg": "./dist/pie-item-player.js",
	"jsdelivr": "./dist/pie-item-player.js",
	"main": "./dist/pie-item-player.js",
	"types": "./dist/pie-item-player.d.ts",
	"exports": {
		".": {
			"types": "./dist/pie-item-player.d.ts",
			"import": "./dist/pie-item-player.js"
		},
		"./preloaded": {
			"types": "./dist/preloaded.d.ts",
			"import": "./dist/preloaded.js"
		},
		"./components/item-session-debugger-element": {
			"types": "./dist/components/item-session-debugger-element.d.ts",
			"import": "./dist/components/item-session-debugger-element.js"
		}
	},
	"customElements": "custom-elements.json",
	"files": [
		"dist",
		"custom-elements.json"
	],
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@pie-players/pie-context": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.2",
		"@happy-dom/global-registrator": "^21.0.4",
		"@pie-players/pie-theme": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"rollup": "^4.65.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vite-plugin-dts": "^5.1.2"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/item-player#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
