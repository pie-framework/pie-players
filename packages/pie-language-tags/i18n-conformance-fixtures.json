{
	"$comment": "Cross-repository conformance spec for the two PIE i18n engines: pie-players' players-shared/src/i18n and pie-elements-ng's @pie-element/shared-i18n, which share this package's language-tag code and keep their own providers. Both repositories read this one file from @pie-players/pie-language-tags and run it against their own engine. A case that only one engine passes is drift, and the fix goes to the engine, not the fixture. Locale tags are full where CLDR defaults differ by region: bare `ar` formats Latin digits and `ar-SA` Arabic-Indic, which is CLDR, not an engine.",
	"lookupSequence": [
		{ "tag": "nl-BE", "expected": ["nl-be", "nl"] },
		{ "tag": "pt-BR", "expected": ["pt-br", "pt"] },
		{ "tag": "zh-Hans-CN", "expected": ["zh-hans-cn", "zh-hans", "zh"] },
		{ "tag": "sr-Latn-RS", "expected": ["sr-latn-rs", "sr-latn", "sr"] },
		{ "tag": "es", "expected": ["es"] },
		{ "tag": "und", "expected": ["und"] }
	],
	"catalogMatch": [
		{
			"locale": "zh-TW",
			"available": ["en-US", "zh", "zh-Hant"],
			"expected": "zh-Hant"
		},
		{ "locale": "zh-TW", "available": ["en-US", "zh"], "expected": "en-US" },
		{ "locale": "zh-HK", "available": ["en-US", "zh"], "expected": "en-US" },
		{
			"locale": "zh-HK",
			"available": ["en-US", "zh", "zh-TW"],
			"expected": "zh-TW"
		},
		{ "locale": "zh-SG", "available": ["en-US", "zh"], "expected": "zh" },
		{ "locale": "zh-CN", "available": ["en-US", "zh-TW"], "expected": "en-US" },
		{ "locale": "zh", "available": ["en-US", "zh-TW"], "expected": "en-US" },
		{
			"locale": "sr-ME",
			"available": ["en-US", "sr", "sr-Latn"],
			"expected": "sr-Latn"
		},
		{ "locale": "sr-ME", "available": ["en-US", "sr"], "expected": "en-US" },
		{ "locale": "sr-Cyrl-RS", "available": ["en-US", "sr"], "expected": "sr" },
		{ "locale": "sr-Latn", "available": ["en-US", "sr"], "expected": "en-US" },
		{
			"locale": "sr-Latn",
			"available": ["en-US", "sr-ME"],
			"expected": "sr-ME"
		},
		{ "locale": "es-MX", "available": ["en-US", "es"], "expected": "es" },
		{ "locale": "es_MX", "available": ["en-US", "es-ES"], "expected": "es-ES" },
		{ "locale": "pt-BR", "available": ["en-US", "pt-PT"], "expected": "pt-PT" },
		{
			"locale": "de-CH-1996",
			"available": ["en-US", "de-DE"],
			"expected": "en-US"
		},
		{
			"locale": "ca-ES-valencia",
			"available": ["en-US", "ca-AD", "ca-AD-valencia"],
			"expected": "ca-AD-valencia"
		},
		{
			"locale": "en-AU",
			"available": ["en-GB-x-gulf", "en-US"],
			"expected": "en-US"
		}
	],
	"direction": [
		{ "tag": "ar-SA", "expected": "rtl" },
		{ "tag": "he", "expected": "rtl" },
		{ "tag": "fa", "expected": "rtl" },
		{ "tag": "ur", "expected": "rtl" },
		{ "tag": "en-US", "expected": "ltr" },
		{ "tag": "nl-NL", "expected": "ltr" },
		{ "tag": "zh-Hans-CN", "expected": "ltr" }
	],
	"plural": {
		"catalogs": {
			"en-US": { "items": { "one": "{count} o", "other": "{count} x" } },
			"ar-SA": {
				"items": {
					"zero": "{count} z",
					"one": "{count} o",
					"two": "{count} t",
					"few": "{count} f",
					"many": "{count} m",
					"other": "{count} x"
				}
			},
			"pl-PL": {
				"items": {
					"one": "{count} o",
					"few": "{count} f",
					"many": "{count} m",
					"other": "{count} x"
				}
			}
		},
		"cases": [
			{ "locale": "en-US", "count": 1, "expected": "1 o" },
			{ "locale": "en-US", "count": 0, "expected": "0 x" },
			{ "locale": "en-US", "count": 1234.5, "expected": "1,234.5 x" },
			{ "locale": "ar-SA", "count": 0, "expected": "٠ z" },
			{ "locale": "ar-SA", "count": 1, "expected": "١ o" },
			{ "locale": "ar-SA", "count": 2, "expected": "٢ t" },
			{ "locale": "ar-SA", "count": 5, "expected": "٥ f" },
			{ "locale": "ar-SA", "count": 11, "expected": "١١ m" },
			{ "locale": "ar-SA", "count": 100, "expected": "١٠٠ x" },
			{ "locale": "ar-SA", "count": 103, "expected": "١٠٣ f" },
			{ "locale": "pl-PL", "count": 1, "expected": "1 o" },
			{ "locale": "pl-PL", "count": 2, "expected": "2 f" },
			{ "locale": "pl-PL", "count": 5, "expected": "5 m" },
			{ "locale": "pl-PL", "count": 22, "expected": "22 f" },
			{ "locale": "pl-PL", "count": 25, "expected": "25 m" },
			{ "locale": "pl-PL", "count": 1.5, "expected": "1,5 x" }
		]
	},
	"interpolation": [
		{
			"locale": "en-US",
			"template": "Hello {name}",
			"values": { "name": "Ana" },
			"expected": "Hello Ana"
		},
		{
			"locale": "en-US",
			"template": "{name} and {name}",
			"values": { "name": "A" },
			"expected": "A and A"
		},
		{
			"locale": "en-US",
			"template": "Keep {missing} literal",
			"values": {},
			"expected": "Keep {missing} literal"
		},
		{
			"locale": "de-DE",
			"template": "{count} Punkte",
			"values": { "count": 1234.5 },
			"expected": "1.234,5 Punkte"
		},
		{
			"locale": "ar-SA",
			"template": "{count}",
			"values": { "count": 5 },
			"expected": "٥"
		}
	],
	"fallbackChain": {
		"locale": "es-ES",
		"source": { "a": "A", "b": "B" },
		"shipped": { "a": "Á" },
		"hostMessages": { "a": "Ä" },
		"expected": { "a": "Ä", "b": "B", "nope.key": "nope.key" }
	},
	"scenarios": [
		{
			"name": "a host plural override of one category leaves the others to the catalog",
			"locale": "en-US",
			"source": {
				"max": { "one": "{count} answer", "other": "{count} answers" }
			},
			"shipped": {},
			"hostMessages": { "en-US": { "max": { "one": "Just {count} answer" } } },
			"expected": {
				"locale": "en-US",
				"direction": "ltr",
				"t": { "max": "{count} answers" },
				"plural": [
					{ "key": "max", "count": 1, "expected": "Just 1 answer" },
					{ "key": "max", "count": 2, "expected": "2 answers" }
				]
			}
		},
		{
			"name": "a host plural override in a shipped locale falls through to that locale's catalog per category",
			"locale": "es",
			"source": {
				"max": { "one": "{count} answer", "other": "{count} answers" }
			},
			"shipped": {
				"es": {
					"max": { "one": "{count} respuesta", "other": "{count} respuestas" }
				}
			},
			"hostMessages": { "es": { "max": { "one": "Solo {count} respuesta" } } },
			"expected": {
				"locale": "es",
				"direction": "ltr",
				"t": { "max": "{count} respuestas" },
				"plural": [
					{ "key": "max", "count": 1, "expected": "Solo 1 respuesta" },
					{ "key": "max", "count": 2, "expected": "2 respuestas" }
				]
			}
		},
		{
			"name": "a locale's own other form wins over the fallback's category",
			"locale": "es",
			"source": {
				"max": { "one": "{count} answer", "other": "{count} answers" }
			},
			"shipped": { "es": { "max": { "other": "{count} respuestas" } } },
			"hostMessages": {},
			"expected": {
				"locale": "es",
				"direction": "ltr",
				"t": { "max": "{count} respuestas" },
				"plural": [{ "key": "max", "count": 1, "expected": "1 respuestas" }]
			}
		},
		{
			"name": "a regional host override layers over the shipped parent catalog",
			"locale": "es-MX",
			"source": { "a": "A", "b": "B", "c": "C" },
			"shipped": { "es": { "a": "Á", "b": "Bé" } },
			"hostMessages": { "es-MX": { "a": "Ä" } },
			"expected": {
				"locale": "es",
				"direction": "ltr",
				"t": { "a": "Ä", "b": "Bé", "c": "C" },
				"plural": []
			}
		},
		{
			"name": "a parent host override reaches a regional request",
			"locale": "es-MX",
			"source": { "a": "A", "b": "B" },
			"shipped": { "es": { "a": "Á", "b": "Bé" } },
			"hostMessages": { "es": { "a": "Ä" } },
			"expected": {
				"locale": "es",
				"direction": "ltr",
				"t": { "a": "Ä", "b": "Bé" },
				"plural": []
			}
		},
		{
			"name": "host messages match the request whatever their tag's casing",
			"locale": "es",
			"source": { "a": "A", "b": "B" },
			"shipped": { "es": { "a": "Á", "b": "Bé" } },
			"hostMessages": { "ES": { "a": "Ä" } },
			"expected": {
				"locale": "es",
				"direction": "ltr",
				"t": { "a": "Ä", "b": "Bé" },
				"plural": []
			}
		},
		{
			"name": "a locale nothing serves reports the fallback it is served in",
			"locale": "he",
			"source": { "a": "A" },
			"shipped": { "es": { "a": "Á" } },
			"hostMessages": {},
			"expected": {
				"locale": "en-US",
				"direction": "ltr",
				"t": { "a": "A" },
				"plural": []
			}
		},
		{
			"name": "a locale served by host messages alone reports the host-message locale",
			"locale": "he-IL",
			"source": { "a": "A", "b": "B" },
			"shipped": {},
			"hostMessages": { "he": { "a": "א" } },
			"expected": {
				"locale": "he",
				"direction": "rtl",
				"t": { "a": "א", "b": "B" },
				"plural": []
			}
		}
	]
}
