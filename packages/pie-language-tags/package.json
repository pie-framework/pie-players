{
	"name": "@pie-players/pie-language-tags",
	"version": "1.0.0-beta.10",
	"type": "module",
	"description": "BCP 47 language tag lookup and matching shared by the PIE i18n engines, with the conformance spec both engines run",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/pie-language-tags"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./i18n-conformance-fixtures.json": "./dist/i18n-conformance-fixtures.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && cp i18n-conformance-fixtures.json dist/",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
		"lint": "biome lint .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"typescript": "^5.9.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/pie-language-tags#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": false
}
