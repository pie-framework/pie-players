{
	"name": "@pie-players/pie-players-shared",
	"version": "1.0.0-beta.9",
	"type": "module",
	"description": "Shared runtime + UI utilities for PIE players",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/players-shared"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./loader-config": {
			"types": "./dist/loader-config.d.ts",
			"import": "./dist/loader-config.js",
			"default": "./dist/loader-config.js"
		},
		"./security": {
			"types": "./dist/security/index.d.ts",
			"import": "./dist/security/index.js",
			"default": "./dist/security/index.js"
		},
		"./security/private-hosts": {
			"types": "./dist/security/private-hosts.d.ts",
			"import": "./dist/security/private-hosts.js",
			"default": "./dist/security/private-hosts.js"
		},
		"./object": {
			"types": "./dist/object/index.d.ts",
			"import": "./dist/object/index.js",
			"default": "./dist/object/index.js"
		},
		"./promise": {
			"types": "./dist/promise/index.d.ts",
			"import": "./dist/promise/index.js",
			"default": "./dist/promise/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		},
		"./item-session-control": {
			"types": "./dist/item-session-control/index.d.ts",
			"import": "./dist/item-session-control/index.js",
			"default": "./dist/item-session-control/index.js"
		},
		"./timed-media": {
			"types": "./dist/timed-media/index.d.ts",
			"import": "./dist/timed-media/index.js",
			"default": "./dist/timed-media/index.js"
		},
		"./media": {
			"types": "./dist/media/index.d.ts",
			"import": "./dist/media/index.js",
			"default": "./dist/media/index.js"
		},
		"./pie": {
			"types": "./dist/pie/index.d.ts",
			"import": "./dist/pie/index.js",
			"default": "./dist/pie/index.js"
		},
		"./pie/tag-names": {
			"types": "./dist/pie/tag-names.d.ts",
			"import": "./dist/pie/tag-names.js",
			"default": "./dist/pie/tag-names.js"
		},
		"./loaders": {
			"types": "./dist/loaders/index.d.ts",
			"import": "./dist/loaders/index.js",
			"default": "./dist/loaders/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"import": "./dist/i18n/index.js",
			"default": "./dist/i18n/index.js"
		},
		"./i18n/types": {
			"types": "./dist/i18n/types.d.ts",
			"import": "./dist/i18n/types.js",
			"default": "./dist/i18n/types.js"
		},
		"./i18n/provider": {
			"types": "./dist/i18n/provider.d.ts",
			"import": "./dist/i18n/provider.js",
			"default": "./dist/i18n/provider.js"
		},
		"./i18n/catalogs": {
			"types": "./dist/i18n/catalogs.d.ts",
			"import": "./dist/i18n/catalogs.js",
			"default": "./dist/i18n/catalogs.js"
		},
		"./i18n/language-tags": {
			"types": "./dist/i18n/language-tags.d.ts",
			"import": "./dist/i18n/language-tags.js",
			"default": "./dist/i18n/language-tags.js"
		},
		"./nds-icon-button": {
			"types": "./dist/components/vendor/nds/nds-icon-button.d.ts",
			"import": "./dist/components/vendor/nds/nds-icon-button.js",
			"default": "./dist/components/vendor/nds/nds-icon-button.js"
		},
		"./ui/attribute-coercion": {
			"types": "./dist/ui/attribute-coercion.d.ts",
			"import": "./dist/ui/attribute-coercion.js",
			"default": "./dist/ui/attribute-coercion.js"
		},
		"./ui/content-styles": {
			"types": "./dist/ui/content-styles-entry.d.ts",
			"import": "./dist/ui/content-styles-entry.js",
			"default": "./dist/ui/content-styles-entry.js"
		},
		"./ui/fontawesome": {
			"types": "./dist/ui/fontawesome.d.ts",
			"import": "./dist/ui/fontawesome.js",
			"default": "./dist/ui/fontawesome.js"
		},
		"./tools/term-lookup": {
			"types": "./dist/tools/term-lookup.d.ts",
			"import": "./dist/tools/term-lookup.js",
			"default": "./dist/tools/term-lookup.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@pie-element/shared-utils": "0.1.6",
		"@pie-lib/math-rendering-module": "6.0.0",
		"dompurify": "^3.4.17",
		"ipaddr.js": "^2.5.0",
		"semver": "^7.8.5"
	},
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node scripts/bundle-vendored-modules.mjs && mkdir -p dist/components && cp -R src/components/vendor dist/components/vendor && bun ../../scripts/prune-unreachable-declarations.mjs",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
		"lint": "biome lint .",
		"check": "svelte-check --tsconfig ./tsconfig.svelte-check.json",
		"test": "bun test",
		"check-i18n": "bun run src/i18n/scripts/check-coverage.ts",
		"scan-hardcoded": "bun run src/i18n/scripts/scan-hardcoded.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@happy-dom/global-registrator": "^21.0.4",
		"@pie-element/shared-math-rendering-mathjax": "0.1.8",
		"@playwright/test": "^1.64.1",
		"@types/semver": "^7.8.0",
		"es-module-shims": "^2.8.4",
		"esbuild": "^0.28.2",
		"glob": "^13.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/players-shared#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": [
		"./dist/components/vendor/nds/*.js"
	]
}
