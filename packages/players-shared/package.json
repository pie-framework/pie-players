{
	"name": "@pie-players/pie-players-shared",
	"version": "0.3.67",
	"type": "module",
	"description": "Shared runtime + UI utilities for PIE players",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/players-shared"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/index.js",
	"jsdelivr": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./loader-config": {
			"types": "./dist/loader-config.d.ts",
			"import": "./dist/loader-config.js"
		},
		"./security": {
			"types": "./dist/security/index.d.ts",
			"import": "./dist/security/index.js"
		},
		"./object": {
			"types": "./dist/object/index.d.ts",
			"import": "./dist/object/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./formative": {
			"types": "./dist/formative/index.d.ts",
			"import": "./dist/formative/index.js"
		},
		"./pie": {
			"types": "./dist/pie/index.d.ts",
			"import": "./dist/pie/index.js"
		},
		"./pie/tag-names": {
			"types": "./dist/pie/tag-names.d.ts",
			"import": "./dist/pie/tag-names.js"
		},
		"./loaders": {
			"types": "./dist/loaders/index.d.ts",
			"import": "./dist/loaders/index.js"
		},
		"./server/npm-registry": {
			"types": "./dist/server/npm-registry.d.ts",
			"import": "./dist/server/npm-registry.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"import": "./dist/i18n/index.js"
		},
		"./i18n/language-tags": {
			"types": "./dist/i18n/language-tags.d.ts",
			"import": "./dist/i18n/language-tags.js"
		},
		"./nds-icon-button": {
			"types": "./dist/components/vendor/nds/nds-icon-button.d.ts",
			"import": "./dist/components/vendor/nds/nds-icon-button.js"
		},
		"./ui/zoom-compensation": {
			"types": "./dist/ui/zoom-compensation.d.ts",
			"import": "./dist/ui/zoom-compensation.js"
		},
		"./ui/content-styles": {
			"types": "./dist/ui/content-styles.d.ts",
			"import": "./dist/ui/content-styles.js"
		},
		"./tools/term-lookup": {
			"types": "./dist/tools/term-lookup.d.ts",
			"import": "./dist/tools/term-lookup.js"
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@pie-lib/math-rendering-module": "5.1.2",
		"dompurify": "^3.4.13",
		"semver": "^7.8.5"
	},
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && mkdir -p dist/components && cp -R src/components/vendor dist/components/vendor",
		"dev": "tsc -p tsconfig.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check .",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "bun test '.test.ts'",
		"check-i18n": "bun run src/i18n/scripts/check-coverage.ts",
		"scan-hardcoded": "bun run src/i18n/scripts/scan-hardcoded.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@happy-dom/global-registrator": "^20.11.1",
		"@playwright/test": "^1.62.1",
		"@types/semver": "^7.8.0",
		"esbuild": "^0.28.1",
		"glob": "^13.0.0",
		"svelte": "^5.56.8",
		"typescript": "^5.9.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/players-shared#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
