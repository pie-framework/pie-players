			"en-US": { "items": { "one": "{count} o", "other": "{count} x" } },
			"ar-SA": {
				"items": {
					"zero": "{count} z",
					"one": "{count} o",
					"two": "{count} t",
					"few": "{count} f",
					"many": "{count} m",
					"other": "{count} x"
				}
			},
			"pl-PL": {
				"items": {
					"one": "{count} o",
					"few": "{count} f",
					"many": "{count} m",
					"other": "{count} x"
				}
			}
		},
		"cases": [
			{ "locale": "en-US", "count": 1, "expected": "1 o" },
