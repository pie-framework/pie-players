	"interpolation": [
		{ "locale": "en-US", "template": "Hello {name}", "values": { "name": "Ana" }, "expected": "Hello Ana" },
		{ "locale": "en-US", "template": "{name} and {name}", "values": { "name": "A" }, "expected": "A and A" },
