{
	"name": "@pie-players/pie-print-player",
	"version": "0.3.75",
	"description": "Print player for PIE elements - dynamically loads and renders print-friendly versions of PIE elements",
	"type": "module",
	"main": "./dist/print-player.js",
	"module": "./dist/print-player.js",
	"types": "./dist/index.d.ts",
	"unpkg": "./dist/print-player.js",
	"jsdelivr": "./dist/print-player.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/print-player.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun x vite build && bun x tsc --emitDeclarationOnly",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"dev": "bun x vite build --watch",
		"test": "bun test",
		"serve": "bun x vite preview --port 8000"
	},
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.14.5",
		"@pie-players/pie-default-tool-loaders": "workspace:*",
		"@pie-players/pie-theme": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.4",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3",
		"vite": "^8.3.3"
	},
	"keywords": [
		"pie",
		"assessment",
		"print",
		"web-components",
		"custom-elements"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/print-player"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/print-player#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
