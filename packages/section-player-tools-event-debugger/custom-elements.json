								"text": "EventLimitOverrides"
							},
							"default": "{}",
							"fieldName": "maxEventsByLevel"
						},
						{
							"name": "toolkit-coordinator",
							"type": {
								"text": "ToolkitCoordinatorLike | null"
							},
							"default": "null",
							"fieldName": "toolkitCoordinator"
						},
						{
							"name": "section-id",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"fieldName": "sectionId"
						},
						{
							"name": "attempt-id",
							"type": {
								"text": "string"
							},
							"fieldName": "attemptId"
						},
						{
							"name": "persistence-scope",
							"type": {
								"text": "string"
							},
							"default": "\"\"",
							"fieldName": "persistenceScope"
						},
						{
