{
	"name": "@pie-players/pie-section-player-tools-instrumentation-debugger",
	"version": "1.0.0-beta.10",
	"type": "module",
	"description": "Instrumentation debugger panel for PIE players",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/section-player-tools-instrumentation-debugger"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"instrumentation",
		"debugger",
		"web-component"
	],
	"main": "./dist/section-player-tools-instrumentation-debugger.js",
	"module": "./dist/section-player-tools-instrumentation-debugger.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/section-player-tools-instrumentation-debugger.js",
			"default": "./dist/section-player-tools-instrumentation-debugger.js"
		},
		"./package.json": "./package.json"
	},
	"customElements": "custom-elements.json",
	"files": [
		"dist",
		"custom-elements.json",
		"package.json"
	],
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"test": "bun test tests",
		"lint": "biome lint ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"@pie-players/pie-section-player-tools-shared": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vite-plugin-dts": "^5.1.2"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/section-player-tools-instrumentation-debugger#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
