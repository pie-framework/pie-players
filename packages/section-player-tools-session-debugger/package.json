{
	"name": "@pie-players/pie-section-player-tools-session-debugger",
	"version": "0.3.68",
	"type": "module",
	"description": "Session debugger panel for PIE section-player flows",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/section-player-tools-session-debugger"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"section-player",
		"session",
		"debugger",
		"web-component"
	],
	"main": "./dist/section-player-tools-session-debugger.js",
	"module": "./dist/section-player-tools-session-debugger.js",
	"unpkg": "./dist/section-player-tools-session-debugger.js",
	"jsdelivr": "./dist/section-player-tools-session-debugger.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/section-player-tools-session-debugger.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"license": "MIT",
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"@pie-players/pie-section-player-tools-shared": "workspace:*",
		"@pie-players/pie-theme": "workspace:*"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"typecheck": "tsc --noEmit",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome check SectionSessionPanel.svelte index.ts vite.config.ts package.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/section-player-tools-session-debugger#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
