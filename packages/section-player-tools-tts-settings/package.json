{
	"name": "@pie-players/pie-section-player-tools-tts-settings",
	"version": "0.3.74",
	"type": "module",
	"description": "Reusable TTS settings panel for PIE section-player development tools",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/section-player-tools-tts-settings"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"section-player",
		"tts",
		"debugger",
		"web-component"
	],
	"main": "./dist/section-player-tools-tts-settings.js",
	"module": "./dist/section-player-tools-tts-settings.js",
	"unpkg": "./dist/section-player-tools-tts-settings.js",
	"jsdelivr": "./dist/section-player-tools-tts-settings.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/section-player-tools-tts-settings.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "bun test tests",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome lint TtsSettingsPanel.svelte index.ts types.ts vite.config.ts package.json"
	},
	"dependencies": {
		"speech-rule-engine": "5.0.0-rc.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^20.14.5",
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"vite-plugin-dts": "^5.1.2"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/section-player-tools-tts-settings#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
