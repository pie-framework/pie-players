{
	"name": "@pie-players/pie-tool-answer-eliminator",
	"version": "0.3.74",
	"type": "module",
	"description": "Answer eliminator tool for PIE assessment player - supports process-of-elimination test-taking strategy",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/tool-answer-eliminator"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"tool",
		"answer-eliminator",
		"test-strategy",
		"wcag",
		"accessibility"
	],
	"main": "./dist/tool-answer-eliminator.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/tool-answer-eliminator.js"
		},
		"./adapters/adapter-registry": {
			"types": "./dist/adapters/adapter-registry.d.ts",
			"import": "./dist/adapters/adapter-registry.js"
		}
	},
	"files": [
		"dist",
		"package.json"
	],
	"license": "MIT",
	"unpkg": "./dist/tool-answer-eliminator.js",
	"jsdelivr": "./dist/tool-answer-eliminator.js",
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vite build && tsc -p tsconfig.adapters.json",
		"dev": "vite build --watch",
		"test": "bun test tests",
		"typecheck": "tsc --noEmit",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome lint ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^20.14.5",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"vite-plugin-dts": "^5.1.1"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/tool-answer-eliminator#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
