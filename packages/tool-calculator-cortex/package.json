{
	"name": "@pie-players/pie-tool-calculator-cortex",
	"version": "0.3.68",
	"type": "module",
	"description": "Open-source Cortex calculator custom element for PIE assessment players",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/tool-calculator-cortex"
	},
	"publishConfig": { "access": "public" },
	"keywords": ["pie", "assessment", "tool", "calculator", "cortex", "offline"],
	"main": "./dist/pie-tool-calculator-cortex.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/pie-tool-calculator-cortex.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "vite build",
		"test": "bun test tests",
		"typecheck": "tsc --noEmit",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome check ."
	},
	"license": "MIT",
	"unpkg": "./dist/pie-tool-calculator-cortex.js",
	"jsdelivr": "./dist/pie-tool-calculator-cortex.js",
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-tool-calculator-shared": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vite-plugin-dts": "^5.0.3"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/tool-calculator-cortex#readme",
	"bugs": { "url": "https://github.com/pie-framework/pie-players/issues" },
	"engines": { "node": ">=20.0.0" },
	"sideEffects": true
}
