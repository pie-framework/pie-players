{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "NodeNext",
		"types": ["svelte"],
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": true
	},
	// This package has no `.ts` source, so with the Vite config excluded the
	// program is empty; an explicit `files` makes that legal (TS18003).
	// svelte-check covers the component.
	"files": [],
	"include": ["**/*.ts", "**/*.svelte"],
	"exclude": ["node_modules", "dist", "tests", "vite.config.ts"]
}
