{
	"name": "@pie-players/pie-tool-calculator-shared",
	"version": "0.3.75",
	"type": "module",
	"description": "Provider-neutral calculator tool surfaces shared by PIE vendor adapters",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/tool-calculator-shared"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"tool",
		"calculator",
		"shared",
		"wcag"
	],
	"main": "./dist/calculator-element.js",
	"exports": {
		"./calculator-element": {
			"types": "./dist/calculator-element.d.ts",
			"import": "./dist/calculator-element.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "vite build",
		"test": "bun run build && bun test tests",
		"typecheck": "tsc --noEmit",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome lint ."
	},
	"license": "MIT",
	"unpkg": "./dist/calculator-element.js",
	"jsdelivr": "./dist/calculator-element.js",
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-calculator": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@happy-dom/global-registrator": "^20.14.5",
		"@pie-players/pie-context": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"vite": "^8.3.2",
		"vite-plugin-dts": "^5.1.2"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/tool-calculator-shared#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": [
		"./dist/calculator-element.js"
	]
}
