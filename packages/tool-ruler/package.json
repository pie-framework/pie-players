{
	"name": "@pie-players/pie-tool-ruler",
	"version": "1.0.0-beta.10",
	"type": "module",
	"description": "Ruler measurement tool for PIE assessment player",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pie-framework/pie-players.git",
		"directory": "packages/tool-ruler"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pie",
		"assessment",
		"tool",
		"ruler",
		"measurement",
		"geometry",
		"accessibility"
	],
	"main": "./dist/tool-ruler.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/tool-ruler.js",
			"default": "./dist/tool-ruler.js"
		},
		"./package.json": "./package.json"
	},
	"customElements": "custom-elements.json",
	"files": [
		"dist",
		"custom-elements.json",
		"package.json",
		"README.md"
	],
	"license": "MIT",
	"dependencies": {
		"@pie-players/pie-assessment-toolkit": "workspace:*",
		"@pie-players/pie-players-shared": "workspace:*"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch",
		"test": "bun test tests",
		"typecheck": "tsc --noEmit",
		"check": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings options_missing_custom_element:ignore",
		"lint": "biome lint ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@happy-dom/global-registrator": "^21.0.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^5.9.3",
		"vite": "^8.3.3",
		"vite-plugin-dts": "^5.1.2"
	},
	"homepage": "https://github.com/pie-framework/pie-players/tree/master/packages/tool-ruler#readme",
	"bugs": {
		"url": "https://github.com/pie-framework/pie-players/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"sideEffects": true
}
