{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"verbatimModuleSyntax": true,
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"composite": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"],
	"references": [
		{
			"path": "../players-shared"
		},
		{
			"path": "../tts"
		}
	]
}
