{
	"requiredPublishConfigAccess": "public",
	"requiredFields": ["license", "homepage", "bugs", "files", "sideEffects"],
	"requireRepositoryDirectory": true,
	"requiredRepositoryUrl": "git+https://github.com/pie-framework/pie-players.git",
	"requireExportsOrMainTypes": true,
	"requireNodeEngine": true,
	"defaultNodeEngine": ">=20.0.0",
	"svelteRuntimeDependencyRange": "^5.57.0",
	"allowedSvelteRuntimeDependencies": {
		"@pie-players/pie-tool-calculator-shared": "The root entry exports components that the vendor wrappers bundle at build time and render on their own Svelte instance, so it keeps Svelte external; nothing a host installs imports it at runtime. `./calculator-element`, which hosts load, bundles Svelte."
	},
	"allowedUndeclaredRuntimeImports": {
		"@pie-players/pie-calculator-cortex": [
			"https://esm.run/@cortex-js/compute-engine",
			"canvas.js"
		]
	},
	"workspaceRoots": ["packages"],
	"forbiddenPublicExports": {
		"@pie-players/pie-players-shared": [
			"./components",
			"./components/*",
			"./i18n/use-i18n",
			"./i18n/use-i18n-standalone",
			"./ui/use-promise"
		]
	},
	"nodeConsumerImportTargets": {
		"nodeSafe": [
			"@pie-players/pie-assessment-toolkit",
			"@pie-players/pie-default-tool-loaders",
			"@pie-players/pie-players-shared",
			"@pie-players/pie-context",
			"@pie-players/pie-calculator",
			"@pie-players/pie-calculator-cortex",
			"@pie-players/pie-calculator-desmos",
			"@pie-players/pie-tts",
			"@pie-players/tts-client-server",
			"@pie-players/tts-server-core",
			"@pie-players/tts-server-google",
			"@pie-players/tts-server-polly"
		],
		"browserOnly": [
			"@pie-players/pie-item-player",
			"@pie-players/pie-section-player"
		]
	}
}
