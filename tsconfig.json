{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"declarationMap": false,
		// Publishable packages ship only `dist`, so a sourcemap is only usable
		// with `inlineSources`, which embeds every `.ts` file into the published
		// tarball. That was costing ~2.5 MB across the tsc-built packages for
		// debuggability we do not need, while every Vite-built package in the
		// repo already sets `sourcemap: false`. Enabling `sourceMap` again
		// requires re-adding `inlineSources`, or the maps resolve to sources that
		// are not packed.
		"sourceMap": false,
		"composite": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["@types/bun"]
	},
	"files": [],
	"references": [
		{
			"path": "./apps/docs"
		},
		{
			"path": "./tools/cli"
		},
		{
			"path": "./packages/assessment-toolkit"
		},
		{
			"path": "./packages/pie-context"
		},
		{
			"path": "./packages/default-tool-loaders"
		},
		{
			"path": "./packages/item-player"
		},
		{
			"path": "./packages/players-shared"
		},
		{
			"path": "./packages/tool-annotation-toolbar"
		},
		{
			"path": "./packages/tool-answer-eliminator"
		},
		{
			"path": "./packages/tool-calculator-desmos"
		},
		{
			"path": "./packages/tool-calculator-geogebra"
		},
		{
			"path": "./packages/tool-calculator-inline-geogebra"
		},
		{
			"path": "./packages/tool-calculator-shared"
		},
		{
			"path": "./packages/tool-color-scheme"
		},
		{
			"path": "./packages/tool-graph"
		},
		{
			"path": "./packages/tool-line-reader"
		},
		{
			"path": "./packages/tool-periodic-table"
		},
		{
			"path": "./packages/tool-protractor"
		},
		{
			"path": "./packages/tool-ruler"
		},
		{
			"path": "./packages/tool-text-to-speech"
		},
		{
			"path": "./packages/tts"
		},
		{
			"path": "./packages/tts-server-core"
		},
		{
			"path": "./packages/tts-server-polly"
		},
		{
			"path": "./packages/tts-client-server"
		},
		{
			"path": "./packages/calculator"
		},
		{
			"path": "./packages/calculator-desmos"
		},
		{
			"path": "./packages/calculator-geogebra"
		}
	],
	"exclude": ["node_modules", "dist", "build"]
}
