{
	"$schema": "https://turbo.build/schema.json",
	"agentGuidance": false,
	"globalDependencies": [
		"package.json",
		"bun.lock",
		"turbo.json",
		"tsconfig.json",
		"tsconfig.base.json",
		"tsconfig.tests.json"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".svelte-kit/**", "oclif.manifest.json"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/tsconfig.json",
				"$TURBO_ROOT$/tsconfig.base.json",
				"$TURBO_ROOT$/packages/players-shared/*.mjs",
				"$TURBO_ROOT$/packages/players-shared/*.js",
				"$TURBO_ROOT$/packages/players-shared/*.ts",
				"$TURBO_ROOT$/scripts/prune-unreachable-declarations.mjs",
				"$TURBO_ROOT$/scripts/check-svelte-type-imports.mjs"
			]
		},
		"test": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"clean": {
			"cache": false
		}
	}
}
